  agent any
  stages {
    stage("build") {
      steps {
        echo 'buildling the application in main'
      }
    }
    stage ("test") {
      steps {
        echo 'Testing the application in main'
      }
    }
    stage ("deploy") {
      steps {
        echo 'Deploying the application in main'
      }
    }
  }
}   
